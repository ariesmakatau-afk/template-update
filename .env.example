# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.
# Everything is optional for browsing the site; ordering degrades gracefully.

# --- Database & photo storage (Supabase → Project Settings → API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Staff area (/kitchen and /admin) ---
# The shared password staff type in. Changing it signs everyone out.
STAFF_PASSWORD=
# The owner/manager's password: never locked out and never uses one of the
# 3 staff slots. Make it long — 12+ characters.
ADMIN_PASSWORD=
# Any long random string: openssl rand -hex 32
STAFF_SESSION_SECRET=

# --- New-order alerts to the shop phone (Telegram bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Weekly order digest email (resend.com) ---
RESEND_API_KEY=
DIGEST_EMAIL_TO=
DIGEST_EMAIL_FROM=
# Any long random string; Vercel Cron sends it automatically.
CRON_SECRET=

# Web Push (VAPID). Generate your own pair: `npx web-push generate-vapid-keys`.
# The private key goes ONLY in the deploy environment, never in the repo.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
